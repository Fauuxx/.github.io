  <script>
    // Initialize Lucide Icons
    lucide.createIcons();

    // Theme Toggle
    const themeBtn = document.getElementById('theme-toggle');
    const themeIcon = document.getElementById('theme-icon');
    let isDark = true;

    themeBtn.addEventListener('click', () => {
      isDark = !isDark;
      document.body.setAttribute('data-theme', isDark ? 'dark' : 'light');
      themeIcon.setAttribute('data-lucide', isDark ? 'sun' : 'moon');
      lucide.createIcons();
    });

    // Copy Email Action
    document.getElementById('copy-email-hero').addEventListener('click', () => {
      navigator.clipboard.writeText('ericksonisaga@gmail.com');
      showToast('Email copied to clipboard!');
    });

    // Form Handling
    function handleFormSubmit(e) {
      e.preventDefault();
      const name = document.getElementById('name').value;
      showToast(`Thank you, ${name}! Your inquiry has been logged.`);
      e.target.reset();
    }

    function showToast(text) {
      const toast = document.getElementById('toast');
      document.getElementById('toast-text').innerText = text;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 3500);
    }

    // Modal Content Registry
    const modalData = {
      icesuppz: {
        title: "Ice Suppz LLC: Full-Funnel Social Engine",
        subtitle: "Social Media Strategy & Production (Jun 2026 – Present)",
        details: [
          "Developed high-retention short-form video content strategy tailored to health & fitness supplements.",
          "Produced promotional assets using Adobe Premiere Pro, Canva, and CapCut to align with brand guidelines.",
          "Analyzed Meta Business Suite metrics weekly to continuously optimize posting cadence and hashtag clusters.",
          "Supervised direct inquiries and comment responses, maintaining sub-15-minute response speeds."
        ]
      },
      community: {
        title: "Viral Shorts & Facebook Group Scaling",
        subtitle: "U.S. Remote Client (Mar 2024 – Sep 2025)",
        details: [
          "Grew YouTube subscriber base utilizing tailored short-form video reels that capitalized on trending audio.",
          "Orchestrated interactive community events within private Facebook Groups, boosting active comments and shares.",
          "Crafted consistent branded templates that reduced content creation turnarounds by 35%."
        ]
      },
      integr8: {
        title: "Enterprise Systems QA & 'Go-Live' Releases",
        subtitle: "Integr8 Software Solutions (Jan 2024 – Mar 2026)",
        details: [
          "Promoted twice within 12 months for exceptional troubleshooting and automated test coverage.",
          "Successfully deployed and monitored 5 major enterprise implementations across accounting, POS, and construction.",
          "Engineered custom query procedures and diagnostic scripts using JavaScript, SQL, and VB.NET."
        ]
      },
      branding: {
        title: "Visual Identity & Operations Specialist",
        subtitle: "PMU PH Embrowdery by Alberto (Jun 2018 – Jan 2024)",
        details: [
          "Engineered end-to-end visual branding, advertising graphics, and video testimonials across Meta channels.",
          "Managed digital booking workflows and customer relationship communications.",
          "Maintained internal digital inventory management and stock status documentation."
        ]
      }
    };

    function openModal(key) {
      const data = modalData[key];
      if (!data) return;
      const content = `
        <h2 style="font-size:1.6rem; margin-bottom:6px;">${data.title}</h2>
        <p style="color:var(--accent); font-family:'JetBrains Mono',monospace; font-size:0.85rem; margin-bottom:20px;">${data.subtitle}</p>
        <ul style="padding-left:20px; line-height:1.8; color:var(--text-muted);">
          ${data.details.map(pt => `<li style="margin-bottom:8px;">${pt}</li>`).join('')}
        </ul>
      `;
      document.getElementById('modal-content').innerHTML = content;
      document.getElementById('project-modal').classList.add('active');
    }

    function closeModal() {
      document.getElementById('project-modal').classList.remove('active');
    }

    function closeModalOnBackdrop(e) {
      if (e.target.id === 'project-modal') closeModal();
    }

    // Portfolio Filtering
    const filterBtns = document.querySelectorAll('.filter-btn');
    const projectCards = document.querySelectorAll('.project-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const filter = btn.getAttribute('data-filter');

        projectCards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-category').includes(filter)) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Particle Canvas Animation
    const canvas = document.getElementById('particles');
    const ctx = canvas.getContext('2d');
    let particlesArray = [];

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    class Particle {
      constructor() {
        this.x = Math.random() * canvas.width;
        this.y = Math.random() * canvas.height;
        this.size = Math.random() * 2 + 1;
        this.speedX = (Math.random() - 0.5) * 0.8;
        this.speedY = (Math.random() - 0.5) * 0.8;
      }
      update() {
        this.x += this.speedX;
        this.y += this.speedY;
        if (this.x > canvas.width || this.x < 0) this.speedX = -this.speedX;
        if (this.y > canvas.height || this.y < 0) this.speedY = -this.speedY;
      }
      draw() {
        ctx.fillStyle = 'rgba(56, 189, 248, 0.3)';
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    for (let i = 0; i < 45; i++) {
      particlesArray.push(new Particle());
    }

    function animateParticles() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      particlesArray.forEach(p => {
        p.update();
        p.draw();
      });
      requestAnimationFrame(animateParticles);
    }
    animateParticles();

    // Stats Counter Animation
    const counters = document.querySelectorAll('[data-count]');
    let counterStarted = false;

    window.addEventListener('scroll', () => {
      const statsSection = document.querySelector('.stats-row');
      if (!statsSection) return;
      const rect = statsSection.getBoundingClientRect();
      if (rect.top < window.innerHeight && !counterStarted) {
        counterStarted = true;
        counters.forEach(counter => {
          const target = +counter.getAttribute('data-count');
          let current = 0;
          const step = Math.ceil(target / 40);
          const timer = setInterval(() => {
            current += step;
            if (current >= target) {
              counter.innerText = target + (counter.getAttribute('data-count') === '6' ? '+' : (counter.getAttribute('data-count') === '100' ? '%' : ''));
              clearInterval(timer);
            } else {
              counter.innerText = current;
            }
          }, 30);
        });
      }
    });
  </script>
